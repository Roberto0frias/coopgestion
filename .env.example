# COOPGESTION · Variables de entorno
# Copie este archivo como .env y ajuste los valores. El archivo .env NUNCA se versiona.

# --------------------------------------------------------------------------- #
# Django
# --------------------------------------------------------------------------- #
# Genere una clave nueva por entorno, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-50-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --------------------------------------------------------------------------- #
# Base de datos (PostgreSQL 16)
# --------------------------------------------------------------------------- #
# Desarrollo local con el clúster portable de COOPGESTION (puerto 5433).
DATABASE_URL=postgres://coopgestion:coopgestion_dev@127.0.0.1:5433/coopgestion
DB_CONN_MAX_AGE=60

# --------------------------------------------------------------------------- #
# Correo
# --------------------------------------------------------------------------- #
# Esquemas admitidos por django-environ: consolemail://, smtp://, smtps://, filemail://
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=COOPGESTION <no-responder@coopgestion.local>

# --------------------------------------------------------------------------- #
# Seguridad de acceso
# --------------------------------------------------------------------------- #
INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
SEGUNDOS_INACTIVIDAD_SESION=1800

# --------------------------------------------------------------------------- #
# Reglas de negocio
# --------------------------------------------------------------------------- #
# Interruptor fiscal: NO se emite ningún comprobante NCF mientras esté en falso.
# Requiere RNC activo y secuencias autorizadas por la DGII (decisión D-08).
EMISION_NCF_ACTIVA=false

# Monto a partir del cual un retiro requiere segunda firma (decisión D-07).
UMBRAL_RETIRO_DOBLE_FIRMA=50000.00

COOPGESTION_NOMBRE=COOPGESTION
LOG_LEVEL=INFO
