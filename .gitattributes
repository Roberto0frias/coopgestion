# Normalización de finales de línea: el repositorio guarda siempre LF.
# Evita diffs falsos entre Windows (desarrollo) y Linux (producción).
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary

*.ps1 text eol=crlf
*.bat text eol=crlf

uv.lock text eol=lf linguist-generated=true
